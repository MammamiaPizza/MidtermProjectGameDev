[sub_resource type="GDScript" id="GDScript_cx3jm"]
script/source = "extends Control

@onready var player = $\"../Player\"
@onready var boss = $\"../Dimension\"

func _process(delta: float) -> void:
	if player != null:
		$Interface/CanvasLayer/TextureProgressBar.value = player.stamina
		$Interface/CanvasLayer/TextureProgressBar2.value = player.hp
	if boss != null:
		$Interface/CanvasLayer/BossBar.value = boss.hp / 100
"

